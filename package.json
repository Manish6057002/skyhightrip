{
  "name": "chisfis-template",
  "description": "A template for creating a Next.js application with Tailwind CSS and TypeScript.",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-destinations": "tsx scripts/fetch-destinations.ts",
    "fetch-airports": "tsx scripts/fetch-airports.ts",
    "test-activities": "tsx scripts/test-activities.ts",
    "test-activity-booking": "tsx scripts/test-activity-booking.ts",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:push": "dotenv -e .env.local -- prisma db push"
  },
  "dependencies": {
    "@duffel/api": "^4.20.1",
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@hugeicons/core-free-icons": "^1.0.14",
    "@hugeicons/react": "^1.0.5",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "20.9.2",
    "@types/react": "19.1.3",
    "@types/react-datepicker": "^4.19.6",
    "@types/react-dom": "19.1.3",
    "@vis.gl/react-google-maps": "^1.5.2",
    "amadeus": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.3.2",
    "framer-motion": "^12.10.4",
    "lodash": "^4.17.21",
    "next": "15.3.8",
    "next-auth": "^4.24.13",
    "prisma": "^6.19.0",
    "rc-slider": "^11.1.8",
    "react": "19.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "19.1.0",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.0",
    "recharts": "^3.4.1",
    "sharp": "^0.34.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash": "^4.17.13",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^7.4.4",
    "postcss": "^8.4.31",
    "prettier": "^3.3.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3"
  }
}
